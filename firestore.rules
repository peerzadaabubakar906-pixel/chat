rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('email', '') == 'peerzadaabubakar906@gmail.com';
    }

    function isOwner(chatId) {
      return request.auth != null && request.auth.uid == chatId;
    }

    match /chats/{chatId} {
      allow read, write: if isAdmin() || isOwner(chatId);

      match /messages/{msgId} {
        allow read: if isAdmin() || isOwner(chatId);

        allow create: if isAdmin()
          || (isOwner(chatId)
              && request.resource.data.from == 'visitor'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 1000);

        allow update, delete: if isAdmin();
      }
    }
  }
}
